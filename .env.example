# Nextext — example configuration
#
# deploy's `make env` writes .env from this file and keeps it in step
# (by hand: cp .env.example .env).
#
#   KEY=value     set per host
#   # KEY=value   optional; the value shown is the default
#
# Tags, on the line above a setting:
#   [required]          must be set on every host
#   [secret]            never printed; your value never follows the example
#   [shared: M [KEY]]   same value as member M (its KEY); make env fills it
#   [dev]               read only by the dev overlay (make up-dev)
#
# All model inference runs on external services; Nextext ships no weights.
# Every variable it reads, with its default, is in docs/configuration.md.
# Under Docker, docker/compose.yaml points Nextext at the vllm router; a run
# outside Docker (uv run) keeps the code defaults, which are ollama on
# localhost (Inference).

# =============================================================================
# Required
# =============================================================================

# API key for the inference router. Must equal the router's master key (the
# OPENAI_API_KEY in vllm-service's .env); make env fills it in. The NER,
# diarization and VAD stages reuse it as their bearer token.
# [required] [secret] [shared: vllm-service]
OPENAI_API_KEY=

# The one chat model for every text task: translation, summarization,
# hate-speech detection, sentence restoration and keyframe captions. Nextext
# aborts a text task without it. For example
#   TEXT_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4
# [required]
TEXT_MODEL=

# =============================================================================
# Auth & identity
# =============================================================================

# Each request resolves to one identity, used only to scope the caller's
# in-memory jobs. Behind the edge gateway it is the signed-in user, sent as
# this trusted header. Details and rollout order: docs/configuration.md
# (Identity).
# NEXTEXT_AUTH_HEADER=X-Auth-User

# Edge secret: the gateway sends it as X-Edge-Secret, and once it is set here
# the identity header counts only on requests that carry it. Generate it with
# `make secret` in edge-plane, which needs the same value in its own .env
# (also NEXTEXT_EDGE_SECRET); set the gateway's copy first. At least 32
# characters. Unset, the header is trusted from any caller that can reach the
# backend, and startup warns about it.
# [secret] [shared: edge-plane]
# NEXTEXT_EDGE_SECRET=

# Service tokens for services that call the API directly, as comma-separated
# pairs of a name and a token: `Authorization: Bearer <token>` then acts as
# the principal service:<name>, never as a user; no identity header or
# default identity can claim the service: prefix. Generate each token with
# `make secret` in edge-plane; docint's entry takes the same value as
# NEXTEXT_API_KEY in docint's .env, and make env fills it in. Unset accepts
# no service token.
# [secret] [shared: docint NEXTEXT_API_KEY]
# NEXTEXT_SERVICE_TOKENS=

# =============================================================================
# Network & proxy
# =============================================================================

# Name of the external network between the app backends and vllm-service.
# Created via `make network`. Override only if you renamed it.
# INFERENCE_NETWORK=inference-net

# Name of the external network the frontend joins, where the edge-plane
# gateway reaches it as `nextext-frontend`. Override only if you renamed it.
# EDGE_NET=edge-net

# Proxy bypass: comma-separated extra hostnames appended to NO_PROXY/no_proxy
# (service aliases and private CIDR ranges are already in). Must start with a
# leading comma, for example
#   EXTRA_NO_PROXY=,ollama,vllm-router,docint-backend
# EXTRA_NO_PROXY=

# =============================================================================
# Inference
# =============================================================================

# --- Central endpoint ---
# The provider: vllm, ollama or openai. docker/compose.yaml defaults it to
# vllm; the code default, outside Docker, is ollama. A value exported in the
# shell that runs `make up` beats this file.
# INFERENCE_PROVIDER=vllm

# Base URL of the OpenAI-compatible endpoint, including /v1. It carries the
# text tasks and is the fallback every other stage uses when its own
# *_API_BASE is unset. The default is the router on inference-net; point it
# elsewhere to change provider, for example
#   OPENAI_API_BASE=http://ollama:11434/v1
#   OPENAI_API_BASE=https://api.openai.com/v1
# docker/compose.yaml supplies the default; outside Docker it is unset.
# OPENAI_API_BASE=http://vllm-router:4000/v1

# Disable chain-of-thought on Qwen3 and similar models by setting 0. Unset
# sends nothing; a no-op for the vllm and openai providers.
# OLLAMA_THINK=

# --- Per-model dedicated endpoints (optional overrides) ---
# Leave these unset to use the central OPENAI_API_BASE; set one only to point
# a single stage at a different endpoint. NER, diarization and VAD speak a
# plain service root, not the /v1 shape, so when they fall back to
# OPENAI_API_BASE one trailing /v1 is stripped before the client appends its
# path (http://vllm-router:4000/v1 reaches http://vllm-router:4000/gliner).

# Whisper takes an OpenAI-SDK base, including /v1. Unset reuses
# OPENAI_API_BASE verbatim. Ollama serves no transcription API, so with the
# ollama provider set WHISPER_API_BASE and WHISPER_MODEL to an
# OpenAI-compatible STT server.
# WHISPER_API_BASE=

# Bearer token of the Whisper endpoint. Unset reuses OPENAI_API_KEY.
# [secret]
# WHISPER_API_KEY=

# The default depends on the provider:
#   WHISPER_MODEL=openai/whisper-large-v3   (vllm)
#   WHISPER_MODEL=whisper-1                 (openai)
# WHISPER_MODEL=

# GLiNER NER service root; the client appends /gliner. NER runs only when a
# job asks for entities, so it needs no off switch.
# NER_API_BASE=

# Seconds per NER request (per text chunk).
# NER_TIMEOUT=120

# Diarization service root; the client appends /diarize. Diarization runs by
# default for every job, auto-detecting the speaker count, and is bypassed per
# job with diarize=false (CLI --no-diarize). VAD-gating of its turns is
# server-side (vllm-service's DIARIZE_VAD_URL).
# DIARIZE_API_BASE=

# Seconds per diarization request (it can run minutes).
# DIARIZE_TIMEOUT=600

# VAD service root; the client appends /vad. The guard runs on every
# transcription (fail-open: an unreachable service transcribes anyway). Set
# off (also false, no, 0) to switch it off.
# VAD_API_BASE=

# Seconds per VAD request.
# VAD_TIMEOUT=60

# =============================================================================
# Nextext
# =============================================================================

# --- Backend ---
# Bind address and port of uvicorn, inside the container.
# NEXTEXT_API_HOST=0.0.0.0
# NEXTEXT_API_PORT=8000

# Hard cap on the size of one uploaded file, in MB (streamed to disk).
# NEXTEXT_MAX_UPLOAD_MB=8192

# Largest request body the frontend's nginx lets through to the backend.
# NEXTEXT_CLIENT_MAX_BODY_SIZE=8192m

# Gate on spaCy downloads: 1 = offline (the default), 0 allows them.
# NEXTEXT_OFFLINE=1

# Initial translation target of a fresh browser (a supported language code).
# NEXTEXT_DEFAULT_TARGET_LANG=en

# Jobs processed at once (1 = serial). Raise it to parallelize, bounded by
# CPU and inference capacity.
# NEXTEXT_JOB_CONCURRENCY=1

# --- Response language ---
# Language of summaries and hate-speech rationales, taken from the localized
# prompts in nextext/utils/prompts/<code>/ (en, de). Independent of the
# transcription source and the translation target; unsupported values fall
# back to English. Empty means the deprecated NEXTEXT_RESPONSE_LANGUAGE if
# that is set, else en. Supported codes: en, de. The value is also what the
# SPA's UI language follows. A value exported in the shell that runs
# `make up` beats this file.
# renamed: NEXTEXT_RESPONSE_LANGUAGE -> RESPONSE_LANGUAGE
# RESPONSE_LANGUAGE=

# --- Keyframes ---
# Keyframe extraction is opt-in per job (JobOptions.keyframes, the SPA's
# Keyframes checkbox, the CLI's -kf), independent of summarization. These are
# the sampling rates it then uses when a job creation request omits the
# fields; an explicit per-request value always overrides them. Unparseable or
# out-of-range values fall back or clamp instead of failing.

# Keyframes sampled per minute of video.
# KEYFRAMES_PER_MINUTE=4

# Ceiling on frames per clip (clamped to 200).
# KEYFRAMES_MAX=20

# --- Visual context ---
# Within the keyframe step, TEXT_MODEL describes each sampled frame. The
# timestamped captions are a result of their own (the Visual context tab) and
# are folded into a summary when one was requested. This needs a
# vision-capable TEXT_MODEL; captioning is fail-soft, so a text-only model
# yields no captions and no failed job. It costs one inference request per
# captioned frame.

# Operator half of the captioning gate; 0, false, no or off skips it (frames
# are still sampled). A job can also opt out per request.
# NEXTEXT_VISUAL_SUMMARY=1

# Frames captioned per job (clamped to 200).
# VISUAL_SUMMARY_MAX_FRAMES=12

# Longest edge, in pixels, each frame is downscaled to before upload.
# VISUAL_SUMMARY_IMAGE_MAX_SIDE=1024

# --- Sentence restoration ---
# When a transcript's terminal-punctuation density is below the threshold
# (for example Whisper's Arabic output), TEXT_MODEL re-segments it into whole
# sentences, so each row is one sentence. on or off.
# NEXTEXT_SENTENCE_RESTORE=on

# Terminal marks per word below which a transcript counts as
# low-punctuation. Punctuated English and German sit near 0.05-0.07,
# unpunctuated Arabic near 0.
# SENTENCE_RESTORE_MIN_PUNCT_RATIO=0.01

# --- Summary and hate speech ---
# Most transcript tokens sent to TEXT_MODEL in one summary request. Longer
# transcripts are summarized map-reduce (chunk, summarize each, summarize the
# summaries). Lower it for backends with a small max_model_len or token-dense
# scripts such as CJK; raise it to reduce chunking.
# SUMMARY_MAX_INPUT_TOKENS=6000

# Hate-speech detection judges rows in windows: a labelled core of about
# HATE_SPEECH_WINDOW_TOKENS plus about HATE_SPEECH_CONTEXT_TOKENS of read-only
# neighbouring rows on each side (0 disables the context). Only hate the
# speaker endorses is reported.
# HATE_SPEECH_WINDOW_TOKENS=1000
# HATE_SPEECH_CONTEXT_TOKENS=300

# =============================================================================
# Audit & retention
# =============================================================================

# The backend and every nextext-cli run record who collected, queried,
# downloaded, combined or deleted which job, and every transfer to a model, as
# hash-chained JSON lines on stdout (operational logs go to stderr). What is
# recorded: docs/audit.md. The store, its retention and who may read it live
# in obs-plane. docker/compose.yaml sends the chain to the container's stdout
# (AUDIT_OUTPUT=container), so `make cli` runs land in the backend's log.

# Actions that need a stated purpose (X-Audit-Purpose on requests, sent by the
# SPA's purpose bar; AUDIT_CASE_REF / AUDIT_REASON for the CLI), comma-
# separated from: collect, query, disclose, combine, delete, ai_call, modify,
# auth, admin. Without one a request gets 428 and a CLI run exits 2; the
# refusal is recorded. The default asks for query and disclose (§76 BDSG
# Abs. 2): listing jobs, reading a finished result, playing a recording, every
# download and every CLI run need a purpose; uploads and deletes do not. Set
# it empty (AUDIT_REQUIRE_PURPOSE=) to switch the requirement off. Outside
# compose (bare uvicorn, tests) it is empty by default.
# AUDIT_REQUIRE_PURPOSE=query,disclose

# Seconds a media playback grant stays usable: the SPA asks for one, stating
# the purpose, before it plays a recording. At most 86400.
# NEXTEXT_MEDIA_GRANT_TTL_S=900

# What `make cli` leaves in /tmp/nextext-cli on the scratch volume is deleted
# this many days after it was written, recorded (`off` keeps it, for
# development only). A new period deletes nothing for RETENTION_NOTICE_DAYS
# after it took effect; a changed one never deletes sooner than announced
# (docs/cli.md).
# NEXTEXT_CLI_RETENTION_DAYS=365
# RETENTION_NOTICE_DAYS=30

# The operator a CLI run is attributed to (AUDIT_CLI_USER), its case
# reference (AUDIT_CASE_REF) and its stated purpose (AUDIT_REASON) are set per
# run, for example by `make cli CASE_REF=... REASON=...`, not in this file.

# =============================================================================
# Development only
# =============================================================================

# Host port the dev overlay (make up-dev) publishes the frontend on.
# [dev]
# NEXTEXT_HOST_PORT=8501

# Fallback identity for a request without a trusted header (a local run, or a
# header-less client); not a service: name. Without any identity the API
# answers 401. Ignored while NEXTEXT_EDGE_SECRET is set. Leave unset in
# production.
# [dev]
# NEXTEXT_DEFAULT_IDENTITY=

# Where the audit lines go outside Docker: unset or stdout is the process's
# own stdout, container the container's main stdout under a container-wide
# lock. docker/compose.yaml fixes it to container, so this applies outside
# Docker only.
# [dev]
# AUDIT_OUTPUT=stdout
